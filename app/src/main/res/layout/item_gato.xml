<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">

        <ImageView
            android:id="@+id/ivGato"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/ic_cat"
            android:background="@drawable/circle_background"
            android:padding="12dp"
            android:scaleType="centerInside" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNomeGato"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nome do Gato"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                tools:text="Mia" />

            <TextView
                android:id="@+id/tvRacaGato"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Raça"
                android:textSize="14sp"
                android:textColor="@color/gray_dark"
                tools:text="Persa" />

            <TextView
                android:id="@+id/tvTutorGato"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Tutor"
                android:textSize="14sp"
                android:textColor="@color/gray_dark"
                tools:text="João Silva" />

            <TextView
                android:id="@+id/tvIdadePeso"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Idade e Peso"
                android:textSize="14sp"
                android:textColor="@color/gray_dark"
                tools:text="3 anos • 4.5 kg" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btnEditGato"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_edit"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/edit" />

            <ImageButton
                android:id="@+id/btnDeleteGato"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginTop="8dp"
                android:src="@drawable/ic_delete"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/delete" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView> 
